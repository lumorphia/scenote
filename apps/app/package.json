{
  "name": "@lumorphia-scenote/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm models && react-router dev",
    "build": "pnpm models && react-router build",
    "start": "NODE_ENV=production node --env-file-if-exists=../../.env --import ./server/sentry.ts ./server/index.ts",
    "worker": "node --env-file-if-exists=../../.env --import ./server/sentry.ts ./server/worker.ts",
    "places:sync": "node --env-file-if-exists=../../.env ./server/sync-places.ts",
    "typecheck": "react-router typegen && tsc -p tsconfig.json",
    "test": "vitest run",
    "models": "editor-models fetch --out models"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.6",
    "@fastify/under-pressure": "^9.2.0",
    "@huggingface/transformers": "^3.8.1",
    "@lumorphia-scenote/core": "workspace:*",
    "@lumorphia-scenote/db": "workspace:*",
    "@lumorphia/auth-client": "1.1.1",
    "@lumorphia/editor-engine": "1.0.0",
    "@lumorphia/editor-react": "1.0.0",
    "@lumorphia/editor-recipe": "1.0.0",
    "@lumorphia/moderation": "1.0.0",
    "@lumorphia/ops": "1.0.0",
    "@lumorphia/storage": "1.0.0",
    "@mcansh/react-router-fastify": "^5.0.0",
    "@mediapipe/tasks-vision": "^1.1.0",
    "@react-router/node": "^8.4.0",
    "@sentry/node": "^10.76.0",
    "@sentry/react": "^10.76.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "idb-keyval": "^6.3.0",
    "isbot": "^5.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
