# .env.backup に写す (docs/runbook/backup.md)。投稿画像の認証と分けた、バックアップ専用のバケットと認証。chmod 640 (グループ root)
DATABASE_URL=postgres://scenote:REPLACE_WITH_RANDOM_PASSWORD@postgres:5432/scenote
R2_BACKUP_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BACKUP_BUCKET=lumorphia-scenote-backups
R2_BACKUP_ACCESS_KEY_ID=REPLACE_WITH_BACKUP_KEY
R2_BACKUP_SECRET_ACCESS_KEY=REPLACE_WITH_BACKUP_SECRET
