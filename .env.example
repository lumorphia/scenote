# 開発用の値。.env に写して使う (.env はコミットしない)
DATABASE_URL=postgres://scenote:scenote@localhost:5435/scenote

# Lumorphia アカウントでログイン (ADR-0009)。3 つ揃ったときだけログインを出す。
# 手元の accounts (https://accounts.lumorphia.test:8443) にクライアントを登録する手順は docs/runbook/lumorphia-client.md
# LUMORPHIA_ISSUER=https://accounts.lumorphia.test:8443/api/auth
# LUMORPHIA_CLIENT_ID=
# LUMORPHIA_CLIENT_SECRET=
# 手元の accounts の開発の CA (NODE_EXTRA_CA_CERTS) は起動のときにしか読まれないので、ここではなくコマンドの前に付ける (runbook)

# 投稿の画像 (ADR-0011)。開発は既定で手元の .data/storage に置き、アプリ自身が /_storage で受け取って配る。
# ジョブ (派生画像など) もアプリの中で走る。worker で試すときは JOBS_INLINE=0 にして pnpm --filter @lumorphia-scenote/app worker
# STORAGE_DRIVER=fs
# JOBS_INLINE=1
# 本番 (S7): STORAGE_DRIVER=s3、R2_ACCOUNT_ID・R2_ACCESS_KEY_ID・R2_SECRET_ACCESS_KEY・R2_BUCKET、PUBLIC_IMAGE_BASE_URL (R2 のカスタムドメイン)
