# .env.production に写す (docs/runbook/deploy.md)。全て本番専用にし、chmod 640 (グループ root。doco-cd が読む)。
# compose の展開にも --env-file .env.production を渡す。web と worker が同じファイルを読む。
# イメージは普段 latest (リリース済みの最新) を使う。前の版に戻すときだけ書く (ADR-0025)
# SCENOTE_TAG=v1.0.0
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgres://scenote:REPLACE_WITH_RANDOM_PASSWORD@postgres:5432/scenote
# openssl rand -base64 48。Prismtone・accounts の値を流用しない
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_BASE_URL=https://scenote.lumorphia.com
PORT=3200
HOST=0.0.0.0
LOG_LEVEL=info
# Lumorphia アカウント (ADR-0009)。クライアントは lumorphia/accounts の登録スクリプトで作る (docs/runbook/lumorphia-client.md)
LUMORPHIA_ISSUER=https://accounts.lumorphia.com/api/auth
LUMORPHIA_CLIENT_ID=REPLACE_WITH_CLIENT_ID
LUMORPHIA_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
# 投稿の画像 (ADR-0011・ADR-0012)。Scenote 専用のバケットだけを触れる認証にする。Prismtone・accounts と分ける
STORAGE_DRIVER=s3
R2_ACCOUNT_ID=REPLACE_WITH_ACCOUNT_ID
R2_BUCKET=lumorphia-scenote-images
R2_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
R2_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET
# バケットのカスタムドメイン。配信元で /private/ を拒むルールを入れてから使う (docs/runbook/deploy.md)
PUBLIC_IMAGE_BASE_URL=https://scenote-images.lumorphia.com
# 画像の判定は本番では onnx だけ (ADR-0014)。モデルはイメージに入っている
IMAGE_MODERATION=onnx
# 管理画面に入れる運営者の Lumorphia の sub (ADR-0019)。外側は Cloudflare Access で守る
ADMIN_SUBS=REPLACE_WITH_OPERATOR_SUB
# Cloudflare を経由しない通信を Caddy で拒んでから設定する (cloudflare_only)
CLIENT_IP_HEADER=cf-connecting-ip
# Sentry の IP 保存を無効にし、保存期間を確かめてから設定する
# SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# 公開の最初の 1 週間は 1 にして、違反だけを集める
CSP_REPORT_ONLY=0
